{
  "name": "harmont-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev --port 4174",
    "build": "next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "generate": "tsx scripts/generate-docs.ts && tsx scripts/check-error-pages.ts && cp openapi.json public/openapi.json && tsx scripts/generate-dsl-docs.ts && tsx scripts/check-dsl-pages.ts && tsx scripts/generate-sdk-docs.ts && tsx scripts/check-sdk-pages.ts && tsx scripts/check-llms.ts",
    "check:errors": "tsx scripts/check-error-pages.ts",
    "scaffold:errors": "tsx scripts/scaffold-error-pages.ts",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.8.7",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-openapi": "^10.8.1",
    "fumadocs-ui": "^16.8.7",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
